{
  "manifest_version": 1,
  "id": "de.destination-one.connector.toubiz",
  "name": "mein.toubiz",
  "version": "1.0.0",
  "kind": "connector",
  "runtime": "declarative",
  "summary": "Artikel (POI, Gastronomie, Veranstaltungen) aus mein.toubiz abrufen.",
  "publisher": {
    "name": "destination.one GmbH",
    "url": "https://www.destination.one",
    "email": "info@destination.one"
  },
  "license": "MIT",
  "requires": {
    "onedata": ">=1.35"
  },
  "categories": [
    "konnektor",
    "http_json"
  ],
  "data_egress": false,
  "connector": {
    "base_kind": "http_json",
    "source_system": "toubiz",
    "config": {
      "url": "https://mein.toubiz.de/api/v1/article?language=de",
      "items_path": "payload",
      "id_path": "id",
      "type_path": "type",
      "auth": {
        "type": "bearer"
      }
    },
    "hint": "API-Token als Secret"
  }
}
