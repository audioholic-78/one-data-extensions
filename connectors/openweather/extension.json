{
  "manifest_version": 1,
  "id": "de.destination-one.connector.openweather",
  "name": "OpenWeather",
  "version": "1.0.2",
  "kind": "connector",
  "runtime": "declarative",
  "summary": "Aktuelle Wetterdaten für Orte aus OpenWeather übernehmen.",
  "publisher": {
    "name": "destination.one GmbH",
    "url": "https://www.destination.one",
    "email": "info@destination.one"
  },
  "license": "MIT",
  "requires": {
    "onedata": ">=1.35"
  },
  "categories": [
    "konnektor",
    "http_json"
  ],
  "data_egress": false,
  "connector": {
    "base_kind": "http_json",
    "source_system": "openweather",
    "config": {
      "url": "https://api.openweathermap.org/data/2.5/group?id=2852458,2885679&units=metric&lang=de",
      "items_path": "list",
      "id_path": "id",
      "auth": {
        "type": "query",
        "name": "appid"
      }
    },
    "hint": "Wetterdaten; Orts-IDs anpassen"
  }
}
